{
    // STATIC configuration only (server ports, plugin settings, DICOM AET).
    //
    // This file does NOT define the database, storage, or auth config. Those are
    // injected at runtime via ORTHANC__* environment variables in docker-compose.yml:
    //   - ORTHANC__POSTGRESQL__ENABLE_INDEX=true    -> index/metadata in PostgreSQL (orthanc-db)
    //   - ORTHANC__POSTGRESQL__ENABLE_STORAGE=false -> DICOM *files* on the FILESYSTEM
    //        (default StorageDirectory /var/lib/orthanc/db, backed by the `orthanc-data` volume)
    //   - ORTHANC__REGISTERED_USERS                 -> HTTP Basic credentials
    // Source of truth for DB/storage/auth is docker-compose.yml, not this file.
    // (Orthanc's config parser permits // comments.)
    "Name": "Nidan Orthanc",
    "Plugins": [ "/usr/share/orthanc/plugins" ],
    "DicomServerEnabled": true,
    "DicomPort": 4242,
    "DicomAet": "NIDAN_ORTHANC",
    // Carestream Image Suite negotiates up to 64 KB PDUs (DICOM conformance).
    "DicomScpMaxPduLength": 65536,
    "DicomScuTimeout": 30,
    "DicomCheckCalledAet": false,
    "DicomCheckModalityHost": false,
    // C-ECHO / C-STORE from unknown AEs are allowed so first-contact testing works
    // if Image Suite's calling AE is not yet known. MWL C-FIND still requires a
    // registered modality (see DicomModalities).
    "DicomAlwaysAllowEcho": true,
    "DicomAlwaysAllowStore": true,
    "DicomAlwaysAllowFind": false,
    "DicomAlwaysAllowFindWorklist": false,
    "DicomModalities": {
        // Bhalubang Hospital Carestream Image Suite (192.168.10.115).
        // Station Name: ImageSuiteWSD. Institution: Bhalubang Hospital.
        // Factory DICOM Settings AE is "ImageSuite" (SSCU/MWLSCU/SSCP), port 104.
        // Both AETs are registered so MWL C-FIND is accepted whichever calling AE
        // Image Suite uses. Confirm with POST /modalities/<id>/echo after restart.
        "imagesuite-wsd": {
            "AET": "ImageSuiteWSD",
            "Host": "192.168.10.115",
            "Port": 104,
            "Manufacturer": "Generic",
            "AllowEcho": true,
            "AllowFind": true,
            "AllowFindWorklist": true,
            "AllowStore": true,
            "AllowStorageCommitment": true,
            "AllowMove": true,
            "Timeout": 30
        },
        "imagesuite": {
            "AET": "ImageSuite",
            "Host": "192.168.10.115",
            "Port": 104,
            "Manufacturer": "Generic",
            "AllowEcho": true,
            "AllowFind": true,
            "AllowFindWorklist": true,
            "AllowStore": true,
            "AllowStorageCommitment": true,
            "AllowMove": true,
            "Timeout": 30
        }
    },
    "HttpServerEnabled": true,
    "HttpPort": 8042,
    "RemoteAccessAllowed": true,
    "AuthenticationEnabled": true,
    "Worklists": {
        "Enable": true,
        "Database": "/var/lib/orthanc/worklists",
        "FilterIssuerAet": false,
        "LimitAnswers": 0
    },
    "DicomWeb": {
        "Enable": true,
        "Root": "/dicom-web/",
        "EnableWado": true,
        "WadoRoot": "/wado",
        "Ssl": false,
        "StudiesMetadata": "Full",
        "SeriesMetadata": "Full"
    },
    "Ohif": {
        "DataSource": "dicom-web",
        "RouterBasename": "/ohif/"
    },
    "OrthancExplorer2": {
        "Enable": true,
        "IsDefaultOrthancUI": true,
        "UiOptions": {
            "EnableOpenInOhifViewer3": true,
            "OhifViewer3PublicRoot": "/ohif/"
        }
    },
    "LuaScripts": [
        "/etc/orthanc/webhook.lua"
    ]
}